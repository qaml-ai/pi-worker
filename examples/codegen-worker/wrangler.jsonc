{
  "name": "codegen-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "define": {
    "__filename": "\"/typescript.js\"",
    "__dirname": "\"/\""
  },
  "workflows": [
    {
      "binding": "CODEGEN_WORKFLOW",
      "name": "codegen-workflow",
      "class_name": "CodegenWorkflow"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "codegen-files"
    }
  ]
}
